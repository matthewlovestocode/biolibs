{
  "name": "@biolibs/seqio",
  "version": "0.1.0",
  "description": "Read and write sequence files, verified against Biopython: 49 formats in and 26 out, text, binary and XML, plus index for on-demand access. No file system, so it runs in the browser (Bio.SeqIO)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlovestocode/biolibs.git",
    "directory": "packages/seqio"
  },
  "homepage": "https://github.com/matthewlovestocode/biolibs/tree/main/packages/seqio#readme",
  "bugs": {
    "url": "https://github.com/matthewlovestocode/biolibs/issues"
  },
  "dependencies": {
    "@biolibs/core": "0.1.0",
    "@biolibs/seq": "0.1.0",
    "@biolibs/seqfeature": "0.1.0",
    "@biolibs/seqrecord": "0.1.0",
    "@biolibs/align": "0.1.0",
    "@biolibs/nexus": "0.1.0",
    "@biolibs/pdb": "0.1.0"
  }
}
