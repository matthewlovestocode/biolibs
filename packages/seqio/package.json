    "genbank",
    "embl",
    "parser",
    "file-format"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@biolibs/seqio",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlovestocode/biolibs.git",
