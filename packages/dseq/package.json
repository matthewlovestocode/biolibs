{
  "name": "@biolibs/dseq",
  "version": "0.1.0",
  "description": "pydna's sequence layer: Dseq (double-stranded DNA with explicit ends) and pydna's own Seq and ProteinSeq",
  "type": "module",
  "main": "dist/index.js",
