{
  "name": "@biolibs/dseq",
  "version": "0.1.0",
  "description": "Double-stranded DNA whose ends are part of the molecule, verified against pydna: sticky ends that refuse to ligate wrongly, cutting, end chemistry, melting, circles, and pydna's own Seq and ProteinSeq",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlovestocode/biolibs.git",
    "directory": "packages/dseq"
  },
  "homepage": "https://github.com/matthewlovestocode/biolibs/tree/main/packages/dseq#readme",
  "bugs": {
    "url": "https://github.com/matthewlovestocode/biolibs/issues"
  },
  "dependencies": {
    "@biolibs/core": "0.1.0",
    "@biolibs/seq": "0.1.0",
    "@biolibs/restriction": "0.1.0",
    "@biolibs/seguid": "0.1.0",
    "@biolibs/seqtools": "0.1.0"
  }
}
