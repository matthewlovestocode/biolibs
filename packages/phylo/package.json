{
  "name": "@biolibs/phylo",
  "version": "0.1.0",
  "description": "Phylogenetic trees, verified against Biopython: Tree and Clade with search and editing, Newick, NEXUS and phyloXML both ways, strict/majority/Adam consensus, UPGMA, neighbour joining and parsimony (Bio.Phylo)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlovestocode/biolibs.git",
    "directory": "packages/phylo"
  },
  "homepage": "https://github.com/matthewlovestocode/biolibs/tree/main/packages/phylo#readme",
  "bugs": {
    "url": "https://github.com/matthewlovestocode/biolibs/issues"
  },
  "dependencies": {
    "@biolibs/core": "0.1.0",
    "@biolibs/seqfeature": "0.1.0",
    "@biolibs/seqio": "0.1.0",
    "@biolibs/nexus": "0.1.0",
    "@biolibs/align": "0.1.0",
    "@biolibs/seqrecord": "0.1.0"
  }
}
