  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@biolibs/blast",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlovestocode/biolibs.git",
    "directory": "packages/blast"
  },
