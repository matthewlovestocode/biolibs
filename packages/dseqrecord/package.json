    "directory": "packages/dseqrecord"
  },
  "homepage": "https://github.com/matthewlovestocode/biolibs/tree/main/packages/dseqrecord#readme",
  "bugs": {
    "url": "https://github.com/matthewlovestocode/biolibs/issues"
  },
  "dependencies": {
    "@biolibs/core": "0.1.0",
    "@biolibs/seq": "0.1.0",
    "@biolibs/seqfeature": "0.1.0",
    "@biolibs/seqrecord": "0.1.0",
    "@biolibs/dseq": "0.1.0",
    "@biolibs/assembly": "0.1.0",
